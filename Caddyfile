:80 {
	handle /api/* {
		reverse_proxy api:8080
	}

	# api의 헬스체크 라우트는 /api 프리픽스가 없어서 별도로 연결해준다.
	handle /health {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}

# 기본 설치는 오리진 루트. BASE_PATH=/drop 처럼 서브패스에 붙이면 웹 클라이언트가
# /drop/api/... 를 치므로, 프록시가 그 요청에서 /drop 만 벗긴 뒤 API로 넘기고,
# 웹(Next) 요청은 프리픽스를 그대로 남겨야 한다. 아래를 루트 handle 대신 쓴다.
#
# handle /drop/api* {
# 	uri strip_prefix /drop
# 	reverse_proxy api:8080
# }
# handle /drop* {
# 	reverse_proxy web:3000
# }
